(load "/home/kimjin/freelang-metric-store/metric-store.fl")

;; ══════════════════════════════════════════════════════════════════
;; TIER 권한 시스템
;; ── Tier 0: LOCKED   — 조작 완전 차단
;; ── Tier 1: PROTECTED — restart 허가 필요
;; ── Tier 2: NORMAL   — restart/stop 허용, delete 허가
;; ── Tier 3: DEV      — 전체 허용
;; ══════════════════════════════════════════════════════════════════

(defn tier-get-def [cfg tier-num]
  (get (get cfg "tiers") (str tier-num)))

(defn tier-of [proc cfg]
  (let [[$t (get proc "tier")]]
    (if (nil? $t) 2 $t)))

(defn tier-check [action proc cfg confirm-token]
  "권한 체크 결과 반환:
   {:ok true}                     — 허용
   {:ok false :need_confirm true} — 허가 필요
   {:ok false :denied true}       — 완전 차단"
  (let [[$tier  (tier-of proc cfg)]
        [$tdef  (tier-get-def cfg $tier)]
        [$allow (or (get $tdef "allow") [])]
        [$conf  (or (get $tdef "confirm") [])]
        [$deny  (or (get $tdef "deny") [])]]
    (cond
      (some (fn [$d] (= $d action)) $deny)
        {:ok false :denied true
         :reason (str "[Tier " $tier " " (get $tdef "name") "] " action " 금지")}
      (some (fn [$c] (= $c action)) $conf)
        (let [[$expected (get cfg "confirm_token")]
              [$ok       (and (not (nil-or-empty? confirm-token))
                              (= confirm-token $expected))]]
          (if $ok
            {:ok true :confirmed true}
            {:ok false :need_confirm true
             :reason (str "[Tier " $tier " " (get $tdef "name") "] " action " — 허가 토큰 필요")}))
      (some (fn [$a] (= $a action)) $allow)
        {:ok true}
      :else
        {:ok false :denied true
         :reason (str "[Tier " $tier "] " action " — 미정의 액션")})))

;; ── 디렉토리 초기화 ──────────────────────────────────────────────────
(defn pm-init-dirs [cfg]
  (file-mkdir (get cfg "metric_path"))
  (file-mkdir (get cfg "log_dir"))
  (file-mkdir (get cfg "pid_dir")))

;; ── 설정 로드 ────────────────────────────────────────────────────────
(defn pm-load [config-path]
  (let [raw (file-read config-path)]
    (if (nil-or-empty? raw)
      (throw (str "pm-load: 설정 파일 없음 — " config-path))
      (json-parse raw))))

;; ── PID 파일 경로 ────────────────────────────────────────────────────
(defn pid-file [name pid-dir]
  (str pid-dir "/" name ".pid"))

;; ═══════════════════════════════════════════════════════════════════
;; EVENT TIMELINE
;; ─────────────────────────────────────────────────────────────────
;; 모든 프로세스 생명주기 이벤트를 JSONL로 기록.
;; 형식: {"ts":ms, "service":"name", "event":"type", "reason":"...", "restart_count":n}
;; ═══════════════════════════════════════════════════════════════════

(defn tl-log-path [log-dir]
  (str log-dir "/events.jsonl"))

(defn tl-append! [log-dir service event-type reason restart-count]
  (let [entry (json-stringify
                {"ts"            (now-ms)
                 "service"       service
                 "event"         event-type
                 "reason"        reason
                 "restart_count" restart-count})]
    (file-append (tl-log-path log-dir) (str entry "\n"))))

;; JSONL 파일 전체 읽기 → 이벤트 배열 (파일 없으면 빈 배열)
(defn tl-read-all [log-dir]
  (let [path (tl-log-path log-dir)
        raw  (try (file-read path) (catch err nil))]
    (if (nil-or-empty? raw)
      []
      (let [lines (filter (fn [l] (not (str-blank? l)))
                          (str-split raw "\n"))]
        (filter (fn [e] (not (nil? e)))
                (map (fn [l]
                       (try (json-parse l) (catch err nil)))
                     lines))))))

;; 최근 n개 이벤트
(defn tl-last [log-dir n]
  (let [all   (tl-read-all log-dir)
        total (length all)
        start (if (> total n) (- total n) 0)]
    (drop start all)))

;; 특정 서비스 이벤트만 필터
(defn tl-by-service [log-dir service-name]
  (filter (fn [e] (= (get e "service") service-name))
          (tl-read-all log-dir)))

;; 타임라인 텍스트 렌더링 (터미널용)
(defn tl-render [events]
  (str-join "\n"
    (map (fn [e]
           (let [ts      (get e "ts")
                 sec     (floor (/ ts 1000))
                 ms-part (% ts 1000)
                 hh      (str-pad-left (str (% (floor (/ sec 3600)) 24)) 2 "0")
                 mm      (str-pad-left (str (% (floor (/ sec 60)) 60)) 2 "0")
                 ss      (str-pad-left (str (% sec 60)) 2 "0")
                 svc     (get e "service")
                 evt     (get e "event")
                 reason  (or (get e "reason") "")
                 rc      (get e "restart_count")]
             (str "[" hh ":" mm ":" ss "] "
                  svc " — " evt
                  (if (str-blank? reason) "" (str " (" reason ")"))
                  (if (> rc 0) (str " #" rc) ""))))
         events)))

;; ── 프로세스 시작 ────────────────────────────────────────────────────
(defn pm-start [proc log-dir pid-dir]
  (let [name    (get proc "name")
        cmd     (get proc "cmd")
        cwd     (get proc "cwd")
        logf    (str log-dir "/" name ".log")
        pidf    (pid-file name pid-dir)
        cd-part (if (nil-or-empty? cwd) "" (str "cd \"" cwd "\" && "))
        full    (str "setsid sh -c '" cd-part cmd " >> " logf " 2>&1 & echo $!'")
        result  (shell-exec-result full)
        pid     (str-trim (get result "stdout"))]
    (if (and (get result "ok") (not (str-blank? pid)))
      (do (file-write pidf pid)
          (println (str "[PM] 시작: " name " PID=" pid))
          pid)
      (do (println (str "[PM] 시작 실패: " name " — " (get result "stderr")))
          nil))))

;; ── 프로세스 생존 확인 (kill -0) ─────────────────────────────────────
(defn pm-alive? [name pid-dir]
  (let [pidf (pid-file name pid-dir)]
    (if (not (file-exists pidf))
      false
      (let [pid    (str-trim (file-read pidf))
            result (shell-exec-result (str "kill -0 " pid " 2>/dev/null"))]
        (get result "ok")))))

;; ── 프로세스 중지 (2단계: PID + cmdline) ────────────────────────────
(defn pm-stop [name cmd pid-dir]
  (let [pidf (pid-file name pid-dir)]
    (when (file-exists pidf)
      (let [pid (str-trim (file-read pidf))]
        (shell-exec-result (str "kill " pid " 2>/dev/null"))
        (sleep 500)
        (shell-exec-result (str "kill -9 " pid " 2>/dev/null"))))
    (shell-exec-result (str "pkill -f '" cmd "' 2>/dev/null"))
    (when (file-exists pidf) (file-delete pidf))))

;; ── 헬스체크 ─────────────────────────────────────────────────────────
(defn pm-health [proc pid-dir]
  (let [name       (get proc "name")
        health-url (get proc "health_url")]
    (if (nil-or-empty? health-url)
      (pm-alive? name pid-dir)
      (let [result (shell-exec-result (str "curl -s -o /dev/null --max-time 2 '" health-url "' 2>/dev/null"))]
        (get result "ok")))))

;; ── 메트릭 기록 (숫자 시계열) ────────────────────────────────────────
;; event-code: 0.0=정상 1.0=재시작 2.0=최대재시작초과
(defn pm-record [store ts event-code]
  (metric-write store ts event-code))

;; ── 단일 프로세스 감시 ───────────────────────────────────────────────
;; watch_only=true → 헬스체크만, 재시작 없음 (PM2가 관리하는 DB 등)
(defn pm-check-one [proc state-atom]
  (let [name        (get proc "name")
        watch-only  (or (get proc "watch_only") false)
        max-restart (or (get proc "max_restarts") 0)
        state       @state-atom
        stats       (get (get state :stats) name)
        restarts    (get stats :restarts)
        status      (get stats :status)
        cfg         (get state :config)
        pid-dir     (get cfg "pid_dir")
        log-dir     (get cfg "log_dir")
        store       (get (get state :stores) name)]
    (let [alive (pm-health proc pid-dir)]
      (if alive
        ;; ── 살아있음: max/restarting 상태도 ok로 복구
        (do
          (when store
            (let [s2 (pm-record store (now-ms) 0.0)]
              (swap! state-atom assoc-in [:stores name] s2)))
          (when (not (= status "ok"))
            (tl-append! log-dir name "recovered" "health_check_pass" restarts))
          (swap! state-atom assoc-in [:stats name :status] "ok"))
        ;; ── 다운됨
        (do
          ;; watch_only: 재시작 없이 상태만 기록
          (when watch-only
            (tl-append! log-dir name "down_detected" "watch_only_no_restart" restarts)
            (swap! state-atom assoc-in [:stats name :status] "down"))
          (when (not watch-only)
          ;; max/stopped 상태에서는 재시작 시도 안 함 (상태만 유지)
          ;; stopped = 수동 중지 → start 전까지 watchdog 되살리지 않음
          (when (and (not (= status "max")) (not (= status "stopped")))
            (println (str "[PM] 다운 감지: " name " (재시작 " restarts "/" max-restart ")"))
            ;; ── EVENT: crashed ──────────────────────────────────────
            (tl-append! log-dir name "crashed" "watchdog_down_detected" restarts)
            (if (>= restarts max-restart)
              (do
                (println (str "[PM] 최대 재시작 초과: " name))
                ;; ── EVENT: max_restarts_exceeded ────────────────────
                (tl-append! log-dir name "max_restarts_exceeded" "restart_limit_reached" restarts)
                (when store
                  (let [s2 (pm-record store (now-ms) 2.0)]
                    (swap! state-atom assoc-in [:stores name] s2)))
                (swap! state-atom assoc-in [:stats name :status] "max"))
              (do
                (pm-stop name (get proc "cmd") pid-dir)
                (pm-start proc log-dir pid-dir)
                ;; ── EVENT: restart_attempt ──────────────────────────
                (tl-append! log-dir name "restart_attempt" "watchdog_auto_restart" (+ restarts 1))
                (when store
                  (let [s2 (pm-record store (now-ms) 1.0)]
                    (swap! state-atom assoc-in [:stores name] s2)))
                (swap! state-atom assoc-in [:stats name]
                       {:restarts (+ restarts 1) :status "restarting"}))))))))))

;; ── 전체 감시 루프 ───────────────────────────────────────────────────
(define pm-state (atom {:procs [] :stats {} :stores {} :config {}}))

(defn pm-run-check []
  (let [state @pm-state
        procs (get state :procs)]
    (doseq [proc procs]
      (pm-check-one proc pm-state))))

;; ── PM 시작 진입점 ───────────────────────────────────────────────────
(defn pm-start-all [config-path]
  (let [cfg      (pm-load config-path)
        procs    (get cfg "processes")
        mpath    (get cfg "metric_path")
        log-dir  (get cfg "log_dir")
        pid-dir  (get cfg "pid_dir")
        interval (get cfg "check_interval_ms")]
    (pm-init-dirs cfg)
    (let [stats  (reduce (fn [acc p]
                           (assoc acc (get p "name") {:restarts 0 :status "starting"}))
                         {} procs)
          ;; 메트릭 영속화는 선택적 서브시스템 — 실패해도 감시/재시작은 동작.
          ;; (metric-store는 fd-open "r+" 필요, 현 런타임 미지원 → 별도 태스크)
          stores (reduce (fn [acc p]
                           (let [n    (get p "name")
                                 path (str mpath "/" n ".bin")]
                             (assoc acc n
                               (try (metric-open path nil)
                                    (catch $e
                                      (do (println (str "[PM] 메트릭 비활성(" n "): " $e))
                                          nil))))))
                         {} procs)]
      (reset! pm-state {:procs procs :stats stats :stores stores
                        :config (assoc cfg "config_path" config-path)})
      ;; 초기 기동 + 시작 이벤트
      ;; watch_only=true 서비스는 PM2가 관리 → 기동 건너뜀
      (doseq [proc procs]
        (let [name       (get proc "name")
              watch-only (or (get proc "watch_only") false)]
          (when (and (not watch-only) (not (pm-alive? name pid-dir)))
            (pm-start proc log-dir pid-dir)
            (tl-append! log-dir name "started" "pm_initial_start" 0)
            (swap! pm-state assoc-in [:stats name :status] "ok"))))
      ;; 감시 루프
      ;; 기본 30초 (서비스 52개 × HTTP → 10초는 너무 짧음)
      (let [ms (if (nil-or-empty? interval) 30000 interval)]
        (set-interval "pm-run-check" ms)
        (println (str "[PM] 감시 시작 — " (length procs) "개 프로세스, " ms "ms 간격"))))))
