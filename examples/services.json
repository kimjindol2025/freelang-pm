{
  "tiers": {
    "0": {
      "name": "LOCKED",
      "desc": "DB/인프라 — 모든 조작 차단",
      "color": "#ff5252",
      "allow": ["status", "metrics"],
      "confirm": [],
      "deny": ["start", "stop", "restart", "delete"]
    },
    "1": {
      "name": "PROTECTED",
      "desc": "핵심 서비스 — restart 허가 필요",
      "color": "#ffab40",
      "allow": ["status", "metrics"],
      "confirm": ["restart"],
      "deny": ["stop", "delete"]
    },
    "2": {
      "name": "NORMAL",
      "desc": "일반 앱 — restart/stop 허용, delete 허가",
      "color": "#ffee58",
      "allow": ["status", "metrics", "restart", "stop"],
      "confirm": ["delete"],
      "deny": []
    },
    "3": {
      "name": "DEV",
      "desc": "개발/테스트 — 전체 허용",
      "color": "#00e676",
      "allow": ["status", "metrics", "restart", "stop", "delete", "start"],
      "confirm": [],
      "deny": []
    }
  },
  "confirm_token": "flpm-confirm-2026",
  "processes": [
    {
      "name": "hive-selftest",
      "cmd": "while true; do date >> /tmp/hive-pm-data/selftest.beat; sleep 2; done",
      "tier": 3,
      "max_restarts": 5,
      "note": "Phase1 자동복구 검증용 일회용 DEV 프로세스 — 운영 서비스 아님(no-kill 락 무관)"
    }
  ],
  "metric_path": "/tmp/hive-pm-data/metrics",
  "log_dir": "/tmp/hive-pm-data/logs",
  "pid_dir": "/tmp/hive-pm-data/pids",
  "check_interval_ms": 5000
}
