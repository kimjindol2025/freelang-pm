(load "/root/kim/freelang-pm/pm.fl")

(define PORT 41901)

;; ── 헬퍼 ─────────────────────────────────────────────────────────────
(defn qparam [req key]
  (get (get req "query") key))

;; ── GET /api/status — 전체 상태 ──────────────────────────────────────
(server-get "/api/status"
  (fn [req]
    (let [state  @pm-state
          procs  (get state :procs)
          stats  (get state :stats)
          result (map (fn [p]
                        (let [name (get p "name")
                              st   (get stats name)]
                          {"name"     name
                           "status"   (get st :status)
                           "restarts" (get st :restarts)
                           "cmd"      (get p "cmd")}))
                      procs)]
      (server-json {"ok" true "processes" result}))))

;; ── GET /api/status/:name — 단일 상태 + 메트릭 ──────────────────────
(server-get "/api/status/:name"
  (fn [req]
    (let [name   (get (get req "params") "name")
          state  @pm-state
          stats  (get state :stats)
          stores (get state :stores)
          st     (get stats name)
          store  (get stores name)]
      (if (nil? st)
        (server-json {"ok" false "error" "프로세스 없음"})
        (let [metrics (if store (metric-read-last store 10) [])]
          (server-json {"ok"       true
                        "name"     name
                        "status"   (get st :status)
                        "restarts" (get st :restarts)
                        "metrics"  metrics}))))))

;; ── POST /api/restart/:name — 수동 재시작 ────────────────────────────
(server-post "/api/restart/:name"
  (fn [req]
    (let [name  (get (get req "params") "name")
          state @pm-state
          procs (get state :procs)
          proc  (find-first (fn [p] (= (get p "name") name)) procs)
          cfg   (get state :config)]
      (if (nil? proc)
        (server-json {"ok" false "error" "프로세스 없음"})
        (do
          (pm-stop name (get proc "cmd") (get cfg "pid_dir"))
          (pm-start proc (get cfg "log_dir") (get cfg "pid_dir"))
          (swap! pm-state assoc-in [:stats name :status] "ok")
          (server-json {"ok" true "restarted" name}))))))

;; ── POST /api/stop/:name — 수동 중지 ────────────────────────────────
(server-post "/api/stop/:name"
  (fn [req]
    (let [name  (get (get req "params") "name")
          state @pm-state
          procs (get state :procs)
          proc  (find-first (fn [p] (= (get p "name") name)) procs)
          cfg   (get state :config)]
      (if (nil? proc)
        (server-json {"ok" false "error" "프로세스 없음"})
        (do
          (pm-stop name (get proc "cmd") (get cfg "pid_dir"))
          (swap! pm-state assoc-in [:stats name :status] "stopped")
          (server-json {"ok" true "stopped" name}))))))

;; ── POST /api/start/:name — 수동 시작 ────────────────────────────────
(server-post "/api/start/:name"
  (fn [req]
    (let [name  (get (get req "params") "name")
          state @pm-state
          procs (get state :procs)
          proc  (find-first (fn [p] (= (get p "name") name)) procs)
          cfg   (get state :config)]
      (if (nil? proc)
        (server-json {"ok" false "error" "프로세스 없음"})
        (do
          (pm-start proc (get cfg "log_dir") (get cfg "pid_dir"))
          (swap! pm-state assoc-in [:stats name :status] "ok")
          (server-json {"ok" true "started" name}))))))

;; ── GET /api/config — 현재 설정 ──────────────────────────────────────
(server-get "/api/config"
  (fn [req]
    (let [cfg (get @pm-state :config)]
      (server-json {"ok" true "config" cfg}))))

(defn start-server [config-path]
  (pm-start-all config-path)
  (println (str "[PM] HTTP API: http://localhost:" PORT))
  (server-start PORT))
